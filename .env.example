# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Slack App
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_APP_TOKEN=xapp-...

# Email (SMTP)
SMTP_USER=
SMTP_PASS=

# Email (Resend) — alternative to SMTP
RESEND_API_KEY=re_...

# Dashboard auth — production refuses to boot with the default password
DASHBOARD_USER=admin
DASHBOARD_PASS=change-me-to-a-strong-password

# Data directory (default: ./data)
DATA_DIR=./data

# Sentry error tracking — optional
SENTRY_DSN=

# Webhook notifier — optional
WEBHOOK_URL=
WEBHOOK_SECRET=
