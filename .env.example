# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Slack App
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_APP_TOKEN=xapp-...

# Email (SMTP)
SMTP_USER=
SMTP_PASS=

# Email (Resend) — alternative to SMTP
RESEND_API_KEY=re_...

# Dashboard auth — production refuses to boot with the default password
DASHBOARD_USER=admin
DASHBOARD_PASS=change-me-to-a-strong-password

# Data directory (default: ./data)
DATA_DIR=./data

# REST API bearer token — required to enable /api/v1/* (unset = API returns 503)
API_TOKEN=

# Sentry error tracking — optional
SENTRY_DSN=

# Webhook notifier — optional
WEBHOOK_URL=
WEBHOOK_SECRET=

# Uptime checks — optional tuning
UPTIME_INTERVAL_SECONDS=60
SSL_WARN_DAYS=14

# Per-URL form-login credentials (optional). Example:
# ADMIN_USER=admin@example.com
# ADMIN_PASS=changeme
# The env var names are referenced by the per-URL auth config in config.yaml.
