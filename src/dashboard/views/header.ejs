<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title>PageGuard — <%= typeof title !== 'undefined' ? title : 'Dashboard' %></title>
  <style>
    :root {
      --bg: #090b10;
      --surface: #12151e;
      --surface2: #1a1e2e;
      --surface3: #222840;
      --border: #263354;
      --border-light: #2d3d66;
      --text: #e4e8f7;
      --text-muted: #7b84a3;
      --text-dim: #4f5776;
      --accent: #5b7cfa;
      --accent-glow: rgba(91, 124, 250, 0.15);
      --accent-hover: #7b96ff;
      --green: #34d399;
      --green-glow: rgba(52, 211, 153, 0.12);
      --yellow: #fbbf24;
      --yellow-glow: rgba(251, 191, 36, 0.12);
      --red: #f87171;
      --red-glow: rgba(248, 113, 113, 0.12);
      --orange: #fb923c;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      min-height: 100vh;
    }

    /* --- Header --- */
    .top-bar {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      padding: 0 32px;
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 100;
      backdrop-filter: blur(12px);
      background: rgba(18, 21, 30, 0.85);
    }
    .top-bar .logo {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 16px;
      font-weight: 700;
      letter-spacing: -0.3px;
    }
    .top-bar .logo .shield {
      width: 28px;
      height: 28px;
      background: linear-gradient(135deg, var(--accent), #8b5cf6);
      border-radius: 7px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      color: #fff;
      box-shadow: 0 2px 8px rgba(91, 124, 250, 0.3);
    }
    .top-bar nav {
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .top-bar nav a {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 13px;
      font-weight: 500;
      padding: 6px 14px;
      border-radius: 6px;
      transition: all 0.15s;
    }
    .top-bar nav a:hover, .top-bar nav a.active {
      color: var(--text);
      background: var(--surface2);
    }

    /* --- Layout --- */
    .container { max-width: 1280px; margin: 0 auto; padding: 28px 32px; }
    .page-title {
      font-size: 22px;
      font-weight: 700;
      margin-bottom: 4px;
      letter-spacing: -0.4px;
    }
    .page-subtitle {
      font-size: 13px;
      color: var(--text-muted);
      margin-bottom: 24px;
    }

    /* --- Stats row --- */
    .stats-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 12px;
      margin-bottom: 24px;
    }
    .stat-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 16px 20px;
      position: relative;
      overflow: hidden;
    }
    .stat-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
    }
    .stat-card.accent::before { background: linear-gradient(90deg, var(--accent), transparent); }
    .stat-card.green::before { background: linear-gradient(90deg, var(--green), transparent); }
    .stat-card.yellow::before { background: linear-gradient(90deg, var(--yellow), transparent); }
    .stat-card.red::before { background: linear-gradient(90deg, var(--red), transparent); }
    .stat-card .stat-label { font-size: 11px; text-transform: uppercase; letter-spacing: 0.6px; color: var(--text-muted); margin-bottom: 4px; }
    .stat-card .stat-value { font-size: 28px; font-weight: 700; letter-spacing: -1px; }
    .stat-card.accent .stat-value { color: var(--accent); }
    .stat-card.green .stat-value { color: var(--green); }
    .stat-card.yellow .stat-value { color: var(--yellow); }
    .stat-card.red .stat-value { color: var(--red); }

    /* --- Cards --- */
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 24px;
      margin-bottom: 20px;
      transition: border-color 0.2s;
    }
    .card:hover { border-color: var(--border-light); }
    .card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 16px;
    }
    .card-header h2 {
      font-size: 15px;
      font-weight: 600;
      letter-spacing: -0.2px;
    }

    /* --- Tables --- */
    table { width: 100%; border-collapse: collapse; }
    th {
      padding: 10px 14px;
      text-align: left;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--text-dim);
      font-weight: 600;
      border-bottom: 1px solid var(--border);
    }
    td {
      padding: 12px 14px;
      font-size: 13px;
      border-bottom: 1px solid rgba(38, 51, 84, 0.5);
    }
    tr:last-child td { border-bottom: none; }
    tr { transition: background 0.1s; }
    tbody tr:hover { background: rgba(91, 124, 250, 0.03); }

    /* --- Badges --- */
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 3px 10px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.2px;
    }
    .badge::before {
      content: '';
      width: 6px;
      height: 6px;
      border-radius: 50%;
    }
    .badge-ok { background: var(--green-glow); color: var(--green); }
    .badge-ok::before { background: var(--green); box-shadow: 0 0 6px var(--green); }
    .badge-change { background: var(--yellow-glow); color: var(--yellow); }
    .badge-change::before { background: var(--yellow); box-shadow: 0 0 6px var(--yellow); }
    .badge-error { background: var(--red-glow); color: var(--red); }
    .badge-error::before { background: var(--red); box-shadow: 0 0 6px var(--red); }
    .badge-pending { background: rgba(79, 87, 118, 0.15); color: var(--text-dim); }
    .badge-pending::before { background: var(--text-dim); }

    /* --- Buttons --- */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 7px 16px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 500;
      text-decoration: none;
      border: none;
      cursor: pointer;
      transition: all 0.15s;
      white-space: nowrap;
    }
    .btn:hover { transform: translateY(-1px); }
    .btn:active { transform: translateY(0); }
    .btn-primary {
      background: var(--accent);
      color: #fff;
      box-shadow: 0 2px 8px rgba(91, 124, 250, 0.25);
    }
    .btn-primary:hover { background: var(--accent-hover); box-shadow: 0 4px 12px rgba(91, 124, 250, 0.35); }
    .btn-danger { background: rgba(248, 113, 113, 0.12); color: var(--red); border: 1px solid rgba(248, 113, 113, 0.2); }
    .btn-danger:hover { background: rgba(248, 113, 113, 0.2); }
    .btn-success { background: rgba(52, 211, 153, 0.12); color: var(--green); border: 1px solid rgba(52, 211, 153, 0.2); }
    .btn-success:hover { background: rgba(52, 211, 153, 0.2); }
    .btn-outline { background: var(--surface2); color: var(--text-muted); border: 1px solid var(--border); }
    .btn-outline:hover { border-color: var(--border-light); color: var(--text); }
    .btn-sm { padding: 4px 12px; font-size: 12px; border-radius: 6px; }
    .btn-ghost { background: transparent; color: var(--text-muted); padding: 4px 8px; }
    .btn-ghost:hover { color: var(--text); background: var(--surface2); }

    /* --- Forms --- */
    .form-row {
      display: flex;
      gap: 8px;
      align-items: center;
      margin-top: 16px;
    }
    input[type="text"],
    input[type="url"],
    input[type="number"],
    select {
      padding: 9px 14px;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text);
      font-size: 13px;
      font-family: inherit;
      transition: border-color 0.15s;
      outline: none;
    }
    input:focus, select:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-glow);
    }
    input::placeholder { color: var(--text-dim); }
    .form-row input { flex: 1; }
    label { font-size: 12px; font-weight: 500; color: var(--text-muted); margin-bottom: 4px; display: block; }

    /* --- Screenshots --- */
    .screenshots {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-top: 16px;
    }
    .screenshot-frame {
      border-radius: 10px;
      border: 1px solid var(--border);
      overflow: hidden;
      background: var(--surface2);
    }
    .screenshot-frame .frame-label {
      padding: 8px 14px;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--text-muted);
      background: var(--surface);
      border-bottom: 1px solid var(--border);
    }
    .screenshot-frame img {
      width: 100%;
      display: block;
    }
    .screenshot-frame .frame-meta {
      padding: 8px 14px;
      font-size: 11px;
      color: var(--text-dim);
      border-top: 1px solid var(--border);
    }

    /* --- Misc --- */
    a { color: var(--accent); text-decoration: none; }
    a:hover { color: var(--accent-hover); }
    .empty { text-align: center; padding: 48px 24px; color: var(--text-muted); }
    .empty code { background: var(--surface2); padding: 2px 8px; border-radius: 4px; font-size: 12px; }
    .meta { font-size: 13px; color: var(--text-muted); margin-bottom: 8px; }
    .actions { display: flex; gap: 8px; margin: 16px 0; flex-wrap: wrap; }
    .divider { height: 1px; background: var(--border); margin: 16px 0; }
    .inline-form { display: inline-block; }
    .text-dim { color: var(--text-dim); }
    .text-muted { color: var(--text-muted); }
    .text-sm { font-size: 12px; }
    .mt-2 { margin-top: 8px; }
    .mt-4 { margin-top: 16px; }
    .mb-4 { margin-bottom: 16px; }
    .gap-2 { gap: 8px; }

    .settings-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    .settings-grid .field { display: flex; flex-direction: column; }
    .settings-grid .field label { margin-bottom: 6px; }

    .flash {
      padding: 12px 16px;
      border-radius: 8px;
      font-size: 13px;
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .flash-success { background: var(--green-glow); color: var(--green); border: 1px solid rgba(52, 211, 153, 0.2); }
    .flash-error { background: var(--red-glow); color: var(--red); border: 1px solid rgba(248, 113, 113, 0.2); }

    @media (max-width: 768px) {
      .container { padding: 16px; }
      .top-bar { padding: 0 16px; }
      .stats-row { grid-template-columns: 1fr 1fr; }
      .screenshots { grid-template-columns: 1fr; }
      .settings-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <div class="top-bar">
    <div class="logo">
      <div class="shield">P</div>
      PageGuard
    </div>
    <nav>
      <a href="/" class="<%= typeof title !== 'undefined' && title === 'Monitored URLs' ? 'active' : '' %>">Dashboard</a>
      <a href="/settings" class="<%= typeof title !== 'undefined' && title === 'Settings' ? 'active' : '' %>">Settings</a>
    </nav>
  </div>
  <div class="container">
