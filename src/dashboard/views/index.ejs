<% var title = 'Monitored URLs'; %>
<%- include('header') %>

<%
  const okCount = urls.filter(u => u.status === 'ok').length;
  const changeCount = urls.filter(u => u.status === 'change_detected').length;
  const errorCount = urls.filter(u => u.status === 'error').length;
  const pendingCount = urls.filter(u => u.status === 'pending').length;
%>

<h1 class="page-title">Dashboard</h1>
<p class="page-subtitle">Monitoring <%= urls.length %> URL<%= urls.length !== 1 ? 's' : '' %> &middot; Schedule: <code style="background:var(--surface2);padding:2px 6px;border-radius:4px;font-size:12px;"><%= schedule %></code></p>

<div class="stats-row">
  <div class="stat-card accent">
    <div class="stat-label">Total URLs</div>
    <div class="stat-value"><%= urls.length %></div>
  </div>
  <div class="stat-card green">
    <div class="stat-label">Healthy</div>
    <div class="stat-value"><%= okCount %></div>
  </div>
  <div class="stat-card yellow">
    <div class="stat-label">Changes Detected</div>
    <div class="stat-value"><%= changeCount %></div>
  </div>
  <div class="stat-card red">
    <div class="stat-label">Errors</div>
    <div class="stat-value"><%= errorCount %></div>
  </div>
</div>

<% if (typeof flash !== 'undefined' && flash) { %>
  <div class="flash flash-success"><%= flash %></div>
<% } %>

<div class="card">
  <div class="card-header">
    <h2>Monitored URLs</h2>
  </div>

  <% if (urls.length === 0) { %>
    <p class="empty">No URLs configured yet. Add one below or run <code>npm run baseline</code> to get started.</p>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Label</th>
          <th>URL</th>
          <th>Status</th>
          <th>Last Checked</th>
          <th style="text-align:right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% for (const u of urls) { %>
        <tr>
          <td style="font-weight:500;">
            <a href="/url/<%= u.id %>"><%= u.label %></a>
          </td>
          <td class="text-sm text-muted" style="max-width:300px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
            <%= u.url %>
          </td>
          <td>
            <% if (u.status === 'ok') { %>
              <span class="badge badge-ok">Healthy</span>
            <% } else if (u.status === 'change_detected') { %>
              <span class="badge badge-change">Change Detected</span>
            <% } else if (u.status === 'error') { %>
              <span class="badge badge-error">Error</span>
            <% } else { %>
              <span class="badge badge-pending">Pending</span>
            <% } %>
          </td>
          <td class="text-sm text-muted"><%= u.last_checked || 'Never' %></td>
          <td style="text-align:right;">
            <form method="POST" action="/url/<%= u.id %>/check" class="inline-form">
              <button type="submit" class="btn btn-outline btn-sm">Check Now</button>
            </form>
            <form method="POST" action="/url/<%= u.id %>/delete" class="inline-form" onsubmit="return confirm('Remove <%= u.label %> from monitoring?');">
              <button type="submit" class="btn btn-ghost btn-sm" style="color:var(--red);">Remove</button>
            </form>
          </td>
        </tr>
        <% } %>
      </tbody>
    </table>
  <% } %>

  <div class="divider"></div>

  <form method="POST" action="/url/add">
    <div style="font-size:13px; font-weight:500; color:var(--text-muted); margin-bottom:8px;">Add a URL to monitor</div>
    <div class="form-row" style="margin-top:0;">
      <input type="url" name="url" placeholder="https://example.com" required>
      <input type="text" name="label" placeholder="Label (e.g. Homepage)" required style="max-width:240px;">
      <button type="submit" class="btn btn-primary">Add URL</button>
    </div>
  </form>
</div>

<%- include('footer') %>
