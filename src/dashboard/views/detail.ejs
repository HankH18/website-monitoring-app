<% var title = url.label; %>
<%- include('header') %>

<%
  const nowMs = Date.now();
  let muteMs = 0;
  if (url.muted_until) {
    const ts = Date.parse(String(url.muted_until).replace(' ', 'T') + 'Z');
    if (!isNaN(ts)) muteMs = Math.max(0, ts - nowMs);
  }
  const muted = muteMs > 0;
  let sslDays = null;
  if (url.ssl_not_after) {
    const ts = Date.parse(String(url.ssl_not_after).replace(' ', 'T') + (String(url.ssl_not_after).endsWith('Z') ? '' : 'Z'));
    if (!isNaN(ts)) sslDays = (ts - nowMs) / 86400000;
  }
%>

<div style="margin-bottom:20px;">
  <a href="/" class="text-sm text-muted" style="text-decoration:none;">&larr; Back to Dashboard</a>
</div>

<% if (muted) { %>
<div class="card" style="border-left:3px solid var(--text-muted);">
  <div style="display:flex; align-items:center; justify-content:space-between;">
    <div>
      <strong>Muted</strong> — change-detection and uptime alerts paused for <%= Math.ceil(muteMs / 60000) %> more minute<%= Math.ceil(muteMs / 60000) === 1 ? '' : 's' %>
      <div class="text-sm text-dim">Until <%= url.muted_until %></div>
    </div>
    <form method="POST" action="/url/<%= url.id %>/unmute" class="inline-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn btn-outline btn-sm">Unmute</button>
    </form>
  </div>
</div>
<% } else { %>
<div class="card">
  <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
    <span class="text-sm text-muted">Mute alerts:</span>
    <% for (const m of [30, 60, 240, 1440]) { %>
      <form method="POST" action="/url/<%= url.id %>/mute" class="inline-form" style="margin:0;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="minutes" value="<%= m %>">
        <button type="submit" class="btn btn-ghost btn-sm">
          <%= m === 30 ? '30m' : m === 60 ? '1h' : m === 240 ? '4h' : '24h' %>
        </button>
      </form>
    <% } %>
  </div>
</div>
<% } %>

<div class="card">
  <div class="card-header"><h2>Uptime</h2></div>
  <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(160px, 1fr)); gap:16px;">
    <div>
      <div class="text-sm text-dim">Status</div>
      <div style="font-size:18px; font-weight:500;">
        <% if (url.last_status_code != null) { %>
          <% const ok = url.last_status_code >= 200 && url.last_status_code < 400; %>
          <span style="color: var(--<%= ok ? 'green' : url.last_status_code < 500 ? 'yellow' : 'red' %>);"><%= url.last_status_code %></span>
        <% } else if (url.last_status_check) { %>
          <span style="color:var(--red);">DOWN</span>
        <% } else { %>
          <span class="text-dim">—</span>
        <% } %>
      </div>
    </div>
    <div>
      <div class="text-sm text-dim">Response time</div>
      <div style="font-size:18px; font-weight:500;">
        <%= url.last_response_time_ms != null ? url.last_response_time_ms + ' ms' : '—' %>
      </div>
    </div>
    <div>
      <div class="text-sm text-dim">SSL</div>
      <div style="font-size:18px; font-weight:500;">
        <% if (sslDays == null) { %>—
        <% } else if (sslDays < 0) { %><span style="color:var(--red);">EXPIRED</span>
        <% } else { %><span style="color: var(--<%= sslDays < 14 ? 'yellow' : 'text-muted' %>);"><%= Math.floor(sslDays) %> days</span>
        <% } %>
      </div>
    </div>
    <div>
      <div class="text-sm text-dim">Consecutive failures</div>
      <div style="font-size:18px; font-weight:500;"><%= url.consecutive_failures || 0 %></div>
    </div>
    <div>
      <div class="text-sm text-dim">Last uptime check</div>
      <div class="text-sm" style="font-weight:500;"><%= url.last_status_check || 'Never' %></div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <div>
      <h2 style="font-size:18px;"><%= url.label %></h2>
      <a href="<%= url.url %>" target="_blank" class="text-sm" style="font-weight:400;"><%= url.url %></a>
    </div>
    <div style="display:flex; align-items:center; gap:12px;">
      <% if (url.status === 'ok') { %>
        <span class="badge badge-ok">Healthy</span>
      <% } else if (url.status === 'change_detected') { %>
        <span class="badge badge-change">Change Detected</span>
      <% } else if (url.status === 'error') { %>
        <span class="badge badge-error">Error</span>
      <% } else { %>
        <span class="badge badge-pending">Pending</span>
      <% } %>
    </div>
  </div>

  <div style="display:flex; gap:24px; font-size:12px; color:var(--text-dim); margin-bottom:16px;">
    <span>Last checked: <strong style="color:var(--text-muted);"><%= url.last_checked || 'Never' %></strong></span>
    <% if (url.last_change) { %>
      <span>Last change: <strong style="color:var(--text-muted);"><%= url.last_change %></strong></span>
    <% } %>
  </div>

  <div class="actions">
    <form method="POST" action="/url/<%= url.id %>/check" class="inline-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn btn-primary">Run Check Now</button>
    </form>
    <form method="POST" action="/url/<%= url.id %>/baseline" class="inline-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn btn-outline">Capture New Baseline</button>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h2>Monitored Selectors</h2>
    <span class="text-sm text-dim">
      <%= (url.selectors && url.selectors.length > 0) ? url.selectors.length + ' selector(s)' : 'Whole page (no selectors)' %>
    </span>
  </div>
  <form method="POST" action="/url/<%= url.id %>/selectors">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label class="text-sm text-muted" style="display:block; margin-bottom:4px;">CSS selectors, one per line (empty = monitor the whole page)</label>
    <textarea name="selectors" rows="4" placeholder="#main-content&#10;.product-price" style="width:100%; font-family:monospace; font-size:12px;"><%= (url.selectors || []).join('\n') %></textarea>
    <div style="margin-top:8px;">
      <button type="submit" class="btn btn-outline btn-sm">Save Selectors</button>
    </div>
  </form>
</div>

<% if (typeof selectorViews !== 'undefined' && selectorViews && selectorViews.length > 0) { %>
<div class="card">
  <div class="card-header">
    <h2>Selector Snapshots</h2>
    <span class="text-sm text-dim">Reference vs. latest per selector</span>
  </div>
  <% for (const sv of selectorViews) { %>
    <div style="border:1px solid var(--surface2); border-radius:6px; padding:12px; margin-bottom:12px;">
      <div style="font-family:monospace; font-weight:500; margin-bottom:8px;">
        [<%= sv.index %>] <%= sv.selector %>
        <% if (sv.refText !== sv.curText) { %>
          <span class="badge badge-change" style="margin-left:8px;">Changed</span>
        <% } else { %>
          <span class="badge badge-ok" style="margin-left:8px;">Unchanged</span>
        <% } %>
      </div>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
        <div>
          <div class="text-sm text-dim" style="margin-bottom:4px;">Reference</div>
          <% if (sv.refImage) { %>
            <img src="/screenshot/<%= sv.refImage %>" alt="Reference selector" style="max-width:100%; border:1px solid var(--surface2); border-radius:4px;">
          <% } else { %>
            <div class="empty" style="padding:14px; font-size:12px;">No reference image</div>
          <% } %>
          <pre style="margin-top:6px; font-size:11px; max-height:140px; overflow:auto; background:var(--surface2); padding:8px; border-radius:4px; white-space:pre-wrap;"><%= sv.refText || '(empty)' %></pre>
        </div>
        <div>
          <div class="text-sm text-dim" style="margin-bottom:4px;">Latest</div>
          <% if (sv.curImage) { %>
            <img src="/screenshot/<%= sv.curImage %>" alt="Current selector" style="max-width:100%; border:1px solid var(--surface2); border-radius:4px;">
          <% } else { %>
            <div class="empty" style="padding:14px; font-size:12px;">No current image (selector may not match)</div>
          <% } %>
          <pre style="margin-top:6px; font-size:11px; max-height:140px; overflow:auto; background:var(--surface2); padding:8px; border-radius:4px; white-space:pre-wrap;"><%= sv.curText || '(empty)' %></pre>
        </div>
      </div>
    </div>
  <% } %>
</div>
<% } %>

<% if (reference && latest) { %>
<div class="card">
  <div class="card-header">
    <h2>Visual Comparison</h2>
    <% if (latest.id !== reference.id) { %>
      <form method="POST" action="/url/<%= url.id %>/set-reference/<%= latest.id %>" class="inline-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn btn-success btn-sm">Accept Latest as Baseline</button>
      </form>
    <% } %>
  </div>
  <div class="screenshots screenshots-3">
    <div class="screenshot-frame">
      <div class="frame-label">Reference (Baseline)</div>
      <img src="/screenshot/<%= reference.screenshot_path %>" alt="Reference screenshot">
      <div class="frame-meta">Captured: <%= reference.timestamp %></div>
    </div>
    <div class="screenshot-frame">
      <div class="frame-label">Latest Capture</div>
      <img src="/screenshot/<%= latest.screenshot_path %>" alt="Latest screenshot">
      <div class="frame-meta">Captured: <%= latest.timestamp %></div>
    </div>
    <div class="screenshot-frame">
      <div class="frame-label">Diff</div>
      <img
        src="/screenshot/<%= latest.screenshot_path.replace(/screenshot\.png$/, 'diff.png') %>"
        alt="Pixel diff"
        onerror="this.outerHTML='&lt;div class=&quot;empty&quot; style=&quot;padding:32px 14px;font-size:12px;&quot;&gt;No diff available&lt;/div&gt;';">
      <div class="frame-meta">Highlighted pixels changed vs. reference</div>
    </div>
  </div>
  <style>.screenshots-3 { grid-template-columns: 1fr 1fr 1fr; }
    @media (max-width: 1024px) { .screenshots-3 { grid-template-columns: 1fr; } }</style>
</div>
<% } else { %>
<div class="card">
  <p class="empty">No captures yet. Click "Run Check Now" or "Capture New Baseline" to start monitoring.</p>
</div>
<% } %>

<% if (events.length > 0) { %>
<div class="card">
  <div class="card-header">
    <h2>Change History</h2>
    <span class="text-sm text-dim"><%= events.length %> event<%= events.length !== 1 ? 's' : '' %></span>
  </div>
  <table>
    <thead>
      <tr>
        <th>Time</th>
        <th>Pixel Diff</th>
        <th>Text Changes</th>
        <th>AI Verdict</th>
        <th>Summary</th>
        <th>Acknowledged</th>
        <th style="text-align:right;">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% for (const e of events) { %>
      <tr>
        <td class="text-sm text-muted"><%= e.timestamp %></td>
        <td><%= e.pixel_diff_percent.toFixed(1) %>%</td>
        <td><%= e.text_diff_count %> lines</td>
        <td>
          <% if (e.ai_significant === 1) { %>
            <span class="badge badge-change">Significant</span>
          <% } else if (e.ai_significant === 0) { %>
            <span class="badge badge-ok">Trivial</span>
          <% } else { %>
            <span class="badge badge-pending">N/A</span>
          <% } %>
        </td>
        <td class="text-sm" style="max-width:220px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="<%= e.ai_summary || '' %>">
          <%= e.ai_summary || '—' %>
        </td>
        <td>
          <% if (e.acknowledged) { %>
            <span class="badge badge-ok" title="Via <%= e.acknowledged_via %> at <%= e.acknowledged_at %>">Yes</span>
          <% } else if (e.ai_significant === 1) { %>
            <span class="badge badge-change">Pending</span>
          <% } else { %>
            <span class="text-dim">—</span>
          <% } %>
        </td>
        <td style="text-align:right;">
          <% if (e.ai_significant === 1 && !e.acknowledged) { %>
            <form method="POST" action="/event/<%= e.id %>/acknowledge" class="inline-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-success btn-sm">Acknowledge</button>
            </form>
          <% } %>
          <form method="POST" action="/url/<%= url.id %>/set-reference/<%= e.capture_id %>" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-ghost btn-sm">Set as Ref</button>
          </form>
        </td>
      </tr>
      <% } %>
    </tbody>
  </table>
</div>
<% } %>

<% if (captures.length > 0) { %>
<div class="card">
  <div class="card-header">
    <h2>All Captures</h2>
    <span class="text-sm text-dim"><%= captures.length %> capture<%= captures.length !== 1 ? 's' : '' %></span>
  </div>
  <table>
    <thead>
      <tr>
        <th>#</th>
        <th>Timestamp</th>
        <th>Status</th>
        <th>Screenshot</th>
        <th style="text-align:right;">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% for (const c of captures) { %>
      <tr>
        <td class="text-muted"><%= c.id %></td>
        <td class="text-sm"><%= c.timestamp %></td>
        <td>
          <% if (c.is_reference) { %>
            <span class="badge badge-ok">Current Reference</span>
          <% } %>
        </td>
        <td>
          <a href="/screenshot/<%= c.screenshot_path %>" target="_blank" class="text-sm">View Screenshot</a>
        </td>
        <td style="text-align:right;">
          <% if (!c.is_reference) { %>
            <form method="POST" action="/url/<%= url.id %>/set-reference/<%= c.id %>" class="inline-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-outline btn-sm">Set as Reference</button>
            </form>
          <% } %>
        </td>
      </tr>
      <% } %>
    </tbody>
  </table>
</div>
<% } %>

<%- include('footer') %>
